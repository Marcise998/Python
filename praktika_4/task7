seat = int(input("введите место от 1 до 36: "))
if 1 <= seat <= 36:
    coupe = (seat - 1) // 4 + 1
    print("купе в котором введенное место", coupe)
# при делении 1-4 будет 0 и 1. таким образом не получается, что в 1 купер 3 места. поэтому мы уменьшаем количество вводных
# сидений и получаем промежуток 0-3. 4 сидения и = 0.
# далее прибавляется 1, так как не существует купе 0, т.е так мы разделили места на количество купе ..

else:
    print("не существует такого места")
